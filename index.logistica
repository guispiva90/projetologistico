<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HUB DE PROJETOS LOGÍSTICOS | Mediação EaD 80/20 & Engenharia de Projetos</title>
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              cyan: '#06b6d4',
              blue: '#2563eb',
              dark: '#080c14',
              surface: '#0f172a',
              card: '#1e293b',
              border: '#334155',
              accent: '#38bdf8',
              emerald: '#10b981',
              amber: '#f59e0b',
              rose: '#f43f5e',
              violet: '#8b5cf6'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
            mono: ['JetBrains Mono', 'ui-monospace', 'monospace']
          }
        }
      }
    }
  </script>
  <style>
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0b0f19;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #06b6d4;
    }
    .glow-cyan {
      box-shadow: 0 0 30px -8px rgba(6, 182, 212, 0.28);
    }
    .grid-pattern {
      background-size: 28px 28px;
      background-image: linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    }
  </style>
</head>
<body class="bg-brand-dark text-slate-100 min-h-screen flex flex-col font-sans selection:bg-brand-cyan selection:text-black">

  <!-- TOP HEADER / BRANDING & DUAL VIEW MODE -->
  <header class="border-b border-brand-border bg-brand-surface/95 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="h-11 w-11 rounded-xl bg-gradient-to-tr from-cyan-600 via-blue-600 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-cyan-950/60 ring-1 ring-cyan-400/30">
          <i data-lucide="network" class="w-6 h-6"></i>
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-0.5">
            <span class="text-[10px] font-mono font-semibold tracking-wider uppercase px-2 py-0.5 rounded bg-cyan-950 text-cyan-400 border border-cyan-800/80">SENAI EaD • 80/20</span>
            <span class="inline-flex items-center gap-1 text-[10px] text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-800/50 font-mono">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>Síncrono Online → Lab Presencial
            </span>
          </div>
          <h1 class="text-base sm:text-lg md:text-xl font-extrabold tracking-tight text-white flex items-center gap-2">
            HUB DE PROJETOS LOGÍSTICOS
            <span class="text-slate-400 text-xs sm:text-sm font-normal hidden lg:inline">| Mediação Didática & Metodologia de Projetos</span>
          </h1>
        </div>
      </div>

      <!-- Controls: Perspective Switcher & Case/Notebook -->
      <div class="flex flex-wrap items-center gap-2.5 self-start md:self-center">
        <!-- View Mode Switch -->
        <div class="bg-slate-900 p-1 rounded-xl border border-brand-border flex items-center text-xs">
          <button id="viewBtnStudent" onclick="setViewMode('student')" class="px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1.5 bg-cyan-600 text-white font-medium shadow-sm">
            <i data-lucide="graduation-cap" class="w-3.5 h-3.5"></i> Visão Aluno
          </button>
          <button id="viewBtnTeacher" onclick="setViewMode('teacher')" class="px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1.5 text-slate-400 hover:text-white">
            <i data-lucide="presentation" class="w-3.5 h-3.5"></i> Roteiro Docente
          </button>
        </div>

        <!-- BioFrio Case Summary Modal Trigger -->
        <button onclick="openGlobalCaseModal()" class="px-3 py-1.5 rounded-xl text-xs font-medium bg-brand-card hover:bg-slate-700/80 border border-brand-border text-slate-200 transition-all flex items-center gap-1.5">
          <i data-lucide="snowflake" class="w-3.5 h-3.5 text-cyan-400"></i> Caso BioFrio
        </button>

        <!-- Project Notes Drawer Trigger -->
        <button onclick="toggleNotesDrawer()" class="px-3 py-1.5 rounded-xl text-xs font-medium bg-brand-card hover:bg-slate-700/80 border border-brand-border text-cyan-300 transition-all flex items-center gap-1.5 relative">
          <i data-lucide="file-pen" class="w-3.5 h-3.5 text-cyan-400"></i> Caderno do Projeto
          <span id="notesBadge" class="hidden w-2 h-2 rounded-full bg-cyan-400 absolute -top-1 -right-1"></span>
        </button>
      </div>
    </div>

    <!-- 80/20 Pedagogical Bridge Ribbon -->
    <div class="bg-slate-900/90 border-t border-brand-border/60 px-4 sm:px-6 lg:px-8 py-2">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between text-xs gap-2">
        <div class="flex items-center gap-2 text-slate-300">
          <span class="font-mono text-cyan-400 font-bold uppercase tracking-wider flex items-center gap-1">
            <i data-lucide="refresh-cw" class="w-3.5 h-3.5 text-cyan-400"></i> Ponte EaD 80/20:
          </span>
          <span class="text-slate-300 text-[11px] sm:text-xs">
            Nas <strong>aulas ao vivo online</strong>, domina-se a engenharia do projeto com o caso <strong>BioFrio PharmaLog</strong>; no <strong>laboratório presencial</strong>, os alunos aplicam na prática na <strong>LogMais Sul</strong>.
          </span>
        </div>
        <div id="docentModeBanner" class="hidden text-[11px] font-mono text-amber-300 bg-amber-950/60 px-2 py-0.5 rounded border border-amber-800/60 items-center gap-1.5">
          <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> MODO DOCENTE ATIVADO: Perguntas norteadoras e critérios de avaliação destacados
        </div>
      </div>
    </div>

    <!-- TAB NAVIGATION BAR -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-brand-border/40 overflow-x-auto no-scrollbar">
      <nav class="flex space-x-1.5 py-2.5" id="navTabs" aria-label="Aulas do Projeto">
        <!-- Injected via JavaScript -->
      </nav>
    </div>
  </header>

  <!-- MAIN VIEWPORT -->
  <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- HERO MODULE BANNER -->
    <section id="moduleHeroBanner" class="p-5 sm:p-6 rounded-2xl bg-gradient-to-r from-slate-950 via-slate-900 to-brand-surface border border-brand-border/80 relative overflow-hidden glow-cyan grid-pattern">
      <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-5">
        <div class="space-y-2 max-w-3xl">
          <div class="flex flex-wrap items-center gap-2">
            <span id="heroBadgeLesson" class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/40">AULA 1</span>
            <span class="text-xs text-slate-400 font-mono flex items-center gap-1">
              <i data-lucide="video" class="w-3.5 h-3.5 text-cyan-400"></i> Aula Síncrona Online (Conceito)
            </span>
            <span class="text-slate-600">→</span>
            <span class="text-xs text-emerald-400 font-mono flex items-center gap-1">
              <i data-lucide="wrench" class="w-3.5 h-3.5"></i> 4h Presenciais no Laboratório SENAI
            </span>
          </div>
          <h2 id="heroTitle" class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white tracking-tight">Diagnóstico Logístico & Formulação do Problema Científico</h2>
          <p id="heroSubtitle" class="text-xs sm:text-sm text-slate-300 leading-relaxed">Domine o rigor metodológico de transição de simples queixas empíricas para a declaração formal da situação-problema por critérios de engenharia.</p>
        </div>

        <!-- Quick Action Navigators -->
        <div class="flex flex-wrap lg:flex-col gap-2 shrink-0">
          <button onclick="scrollToSection('secao-conceitos-projeto')" class="px-3.5 py-2 rounded-xl text-xs font-medium bg-brand-card hover:bg-slate-700/80 border border-brand-border text-slate-200 transition flex items-center gap-2">
            <i data-lucide="book-marked" class="w-4 h-4 text-cyan-400"></i> Teoria de Projetos
          </button>
          <button onclick="scrollToSection('secao-ferramenta-interativa')" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white transition flex items-center gap-2 shadow-lg shadow-cyan-950">
            <i data-lucide="sliders-horizontal" class="w-4 h-4"></i> Simulador Interativo
          </button>
          <button onclick="scrollToSection('secao-ponte-laboratorio')" class="px-3.5 py-2 rounded-xl text-xs font-medium bg-emerald-950/70 hover:bg-emerald-900/80 border border-emerald-700 text-emerald-300 transition flex items-center gap-2">
            <i data-lucide="door-open" class="w-4 h-4 text-emerald-400"></i> Missão Presencial SENAI
          </button>
        </div>
      </div>
    </section>

    <!-- DYNAMIC LESSON BODY -->
    <div id="dynamicLessonContent" class="space-y-8">
      <!-- Injected via JavaScript -->
    </div>

  </main>

  <!-- NOTES DRAWER (Local Storage Persistent Project Notebook) -->
  <aside id="notesDrawer" class="fixed inset-y-0 right-0 z-50 w-full sm:w-96 bg-brand-surface border-l border-brand-border shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
    <div class="p-4 border-b border-brand-border flex items-center justify-between bg-slate-900">
      <div class="flex items-center gap-2">
        <i data-lucide="file-pen" class="w-5 h-5 text-cyan-400"></i>
        <div>
          <h3 class="text-sm font-bold text-white">Caderno de Trabalho do Projeto</h3>
          <span class="text-[10px] text-slate-400 font-mono">Salvo automaticamente no navegador</span>
        </div>
      </div>
      <button onclick="toggleNotesDrawer()" class="p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    
    <div class="p-4 flex-1 flex flex-col space-y-3 overflow-y-auto">
      <div class="p-2.5 rounded-xl bg-cyan-950/40 border border-cyan-800/60 text-xs text-cyan-200">
        Utilize este espaço durante a aula ao vivo para estruturar suas anotações, hipóteses e respostas que levará para o encontro presencial do laboratório.
      </div>
      
      <div>
        <label class="block text-xs font-mono text-slate-400 mb-1">Selecione o Encontro:</label>
        <select id="notesLessonSelector" onchange="loadCurrentLessonNote()" class="w-full bg-slate-900 border border-brand-border rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-500">
          <option value="1">Aula 1: Diagnóstico & Declaração do Problema</option>
          <option value="2">Aula 2: Benchmarking & Definição de KPIs</option>
          <option value="3">Aula 3: Análise Causal (6M) & Alternativas</option>
          <option value="4">Aula 4: Viabilidade Financeira & Plano 5W2H</option>
          <option value="5">Aula 5: Normas ABNT & Escrita Científica</option>
          <option value="6">Aula 6: Pitch Executivo & Defesa na Banca</option>
        </select>
      </div>

      <div class="flex-1 flex flex-col">
        <label class="block text-xs font-mono text-slate-400 mb-1">Anotações Técnicas da Equipe:</label>
        <textarea id="projectNotesText" oninput="saveCurrentLessonNote()" placeholder="Digite aqui dados coletados, justificativas, fórmulas ou reflexões do projeto..." class="flex-1 w-full bg-slate-900 border border-brand-border rounded-xl p-3 text-xs text-slate-200 focus:outline-none focus:border-cyan-500 font-mono leading-relaxed resize-none"></textarea>
      </div>

      <div class="pt-2 border-t border-brand-border flex items-center justify-between text-[11px] text-slate-400">
        <span id="saveStatusIndicator" class="flex items-center gap-1 text-emerald-400">
          <i data-lucide="check" class="w-3.5 h-3.5"></i> Salvo localmente
        </span>
        <button onclick="copyCurrentNoteToClipboard()" class="hover:text-cyan-400 flex items-center gap-1 transition">
          <i data-lucide="copy" class="w-3.5 h-3.5"></i> Copiar texto
        </button>
      </div>
    </div>
  </aside>

  <!-- MODAL: CONTEXTO GERAL BIOFRIO PHARMALOG -->
  <div id="globalCaseModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-brand-surface border border-brand-border max-w-3xl w-full rounded-2xl p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
      <button onclick="closeGlobalCaseModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
      <div class="flex items-center gap-3 mb-4">
        <div class="p-2.5 rounded-xl bg-cyan-950 text-cyan-400 border border-cyan-800">
          <i data-lucide="snowflake" class="w-6 h-6"></i>
        </div>
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400">Cenário Didático Paralelo Síncrono</span>
          <h3 class="text-lg font-bold text-white">BioFrio PharmaLog S/A • Operações em Cadeia Fria</h3>
        </div>
      </div>
      <div class="space-y-3.5 text-xs sm:text-sm text-slate-300 leading-relaxed">
        <p><strong class="text-white">Perfil Operacional:</strong> Operador Logístico Especializado (3PL) com centro de distribuição regulatório em Campinas/SP e 3 plataformas de cross-docking refrigeradas em Curitiba, Porto Alegre e Florianópolis. Atende mais de 180 hospitais, redes de vacinação e laboratórios oncológicos.</p>
        <p><strong class="text-white">O Desafio Técnico:</strong> Produtos biológicos termolábeis exigem estrito cumprimento da Resolução <strong>RDC nº 430/2020 da ANVISA</strong> (faixa de 2°C a 8°C e ultracongelados a -20°C). Qualquer excursão de temperatura acima de 30 minutos inviabiliza os medicamentos quimioterápicos, acarretando descarte mandatório e penalidades severas.</p>
        <p><strong class="text-white">Papel dos Alunos nas Aulas ao Vivo:</strong> Atuar como consultores de engenharia logística, dominando cada ferramenta metodológica com os dados da BioFrio PharmaLog, para que cheguem ao laboratório presencial plenamente capacitados a resolver a situação análoga da LogMais Sul.</p>
      </div>
      <div class="mt-6 pt-4 border-t border-brand-border flex justify-end">
        <button onclick="closeGlobalCaseModal()" class="px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white font-medium text-xs rounded-xl transition">
          Retornar à Aula Síncrona
        </button>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="border-t border-brand-border bg-brand-surface py-5 mt-14 text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="font-mono text-cyan-400 font-semibold">SENAI EaD</span>
        <span>• Formação Técnica em Logística • Metodologia Integrada 80/20 (100h)</span>
      </div>
      <div class="flex items-center gap-4 text-slate-400 text-[11px] font-mono">
        <span>Aulas Online: Teoria e Métodos</span>
        <span>•</span>
        <span>Laboratório: Prática de Soluções</span>
      </div>
    </div>
  </footer>

  <!-- CORE LOGIC & LESSONS MASTER DATA -->
  <script>
    // MASTER DATA FOR THE 6 CLASSES - DEEP PROJECT CONCEPTS + BIOFRIO DATA + TOOLS
    const lessonsData = [
      {
        id: 1,
        tabName: "1. Diagnóstico & Problema",
        heroBadge: "AULA 1 • ENCONTRO SÍNCRONO 1",
        title: "Diagnóstico Logístico & Formulação do Problema Científico",
        subtitle: "Aprenda a converter queixas vagas em uma Declaração Formal de Escopo (Project Scope Statement), aplicando Linha de Base, SIPOC e a Lei de Pareto com dados reais.",
        
        // CONCEITOS FUNDAMENTAIS DE PROJETOS DETALHADOS
        deepConcepts: [
          {
            tag: "Gestão de Escopo",
            title: "Declaração de Escopo e Linha de Base (Baseline)",
            icon: "file-text",
            detail: "Em projetos logísticos de alta precisão, uma intervenção não pode ter escopo difuso. A Linha de Base (Baseline) congela o estado inicial mensurável da operação (tempo, custo, taxa de refugo) contra o qual todo o sucesso futuro do projeto será aferido perante auditorias.",
            projectImpact: "Evita o 'Scope Creep' (expansão descontrolada de escopo) e estabelece limites contratuais nítidos de entrega."
          },
          {
            tag: "Metodologia Científica",
            title: "Sintoma Operacional vs. Problema Raiz",
            icon: "filter",
            detail: "Um sintoma é a manifestação exterior perceptível (ex: 'o hospital reclamou que a insulina chegou quente'). O problema científico é a falha no sistema que gerou a condição (ex: 'tempo de permanência na doca de staging sem controle térmico excede em 48 minutos a tolerância termolábil').",
            projectImpact: "Impede que a equipe gaste orçamento combatendo efeitos cosméticos em vez da falha estrutural."
          },
          {
            tag: "Formulação do Problema",
            title: "Critérios SMART e Formulação da Pergunta Diretriz",
            icon: "target",
            detail: "A pergunta-chave do projeto deve ser Específica, Mensurável, Atingível, Relevante e Temporal (SMART). Deve responder: 'De que maneira podemos reduzir o tempo de doca da expedição para manter as cargas entre 2°C e 8°C durante o primeiro semestre?'",
            projectImpact: "Guia todas as etapas subsequentes do projeto sem desvios conceituais."
          },
          {
            tag: "Estratificação da Qualidade",
            title: "Princípio de Pareto (Lei 80/20) e Coleta Estruturada",
            icon: "bar-chart-3",
            detail: "A ordenação decrescente de não conformidades com cálculo da curva percentual acumulada. Revela analiticamente que aproximadamente 20% das naturezas de falhas são responsáveis por cerca de 80% do prejuízo financeiro ou das perdas de carga.",
            projectImpact: "Focaliza a alocação de recursos financeiros e humanos onde o retorno operacional é máximo."
          }
        ],

        // CAPACIDADES TRABALHADAS (SENAI)
        capabilities: [
          {
            type: "Técnica",
            name: "Avaliar alternativas para solução de situações-problema",
            application: "Estruturar hipóteses diagnósticas divergentes a partir do cruzamento de relatórios de telemetria e faturas comerciais."
          },
          {
            type: "Técnica",
            name: "Selecionar ferramentas da qualidade coerentes com a situação",
            application: "Justificar por que utilizar a Folha de Verificação associada ao Pareto na triagem e o SIPOC para delimitar a fronteira do processo."
          },
          {
            type: "Socioemocional",
            name: "Iniciativa e Gestão de Tempo no Levantamento",
            application: "Liderar a filtragem de dados brutos e entregar o diagnóstico consolidado dentro do prazo acordado com o cliente."
          },
          {
            type: "Socioemocional",
            name: "Organização e Clareza na Transmissão de Evidências",
            application: "Construir tabelas higienizadas, com unidades de medida oficiais e fontes citadas sem margem para interpretação ambígua."
          }
        ],

        // ESTUDO DE CASO PARALELO SÍNCRONO: BIOFRIO PHARMALOG
        caseStudy: {
          scenarioTitle: "Dossiê Operacional: 6 Meses de Excursões Térmicas na BioFrio",
          description: "No último semestre, o centro de cross-docking da BioFrio registrou 184 ocorrências críticas de devoluções de vacinas e quimioterápicos. A diretoria supunha genericamente que os caminhões refrigerados estavam com defeito. A consultoria técnica realizou a coleta e estratificação rigorosa:",
          tableHeaders: ["Código / Falha Registrada", "Etapa Operacional", "Ocorrências", "% Relativa", "% Acumulada"],
          tableRows: [
            ["F1: Doca de staging sem climatização rápida", "Expedição", "98", "53.2%", "53.2%"],
            ["F2: Selagem inadequada de caixas com gelox", "Montagem Embalagem", "46", "25.0%", "78.2%"],
            ["F3: Erro de conferência manual de lote/temperatura", "Conferência Doca", "21", "11.4%", "89.6%"],
            ["F4: Demora no trânsito urbano (Last-Mile)", "Transporte Externo", "12", "6.5%", "96.1%"],
            ["F5: Falha mecânica no compressor do baú", "Transporte Externo", "7", "3.9%", "100.0%"]
          ],
          analyticalInsight: "Conclusão Técnica da Lei de Pareto: As falhas F1 e F2 (Doca e Selagem) respondem por 78,2% de todas as quebras térmicas. A suspeita da diretoria sobre os caminhões (F5) representa menos de 4% do problema. O escopo do projeto está cientificamente delimitado nas etapas internas de expedição."
        },

        // FERRAMENTA INTERATIVA
        interactiveToolId: "pareto-simulator",
        interactiveToolTitle: "Simulador Dinâmico de Pareto & Estratificação de Falhas",
        interactiveToolDesc: "Edite as quantidades de ocorrências abaixo para recalcular dinamicamente os percentuais e comprovar a distribuição 80/20:",

        // PONTE PEDAGÓGICA PARA O LABORATÓRIO PRESENCIAL
        labMission: {
          title: "Missão no Laboratório Presencial SENAI (Caso LogMais Sul)",
          steps: [
            "Transposição Prática: Assim como filtramos os dados de temperatura da BioFrio, no laboratório sua equipe receberá o Dossiê LogMais Sul com reclamações de atrasos, divergências e avarias de alimentos secos e refrigerados.",
            "Aplicação do SIPOC: Desenhar no papel kraft ou software o mapa SIPOC (Suppliers, Inputs, Process, Outputs, Customers) delimitando exatamente onde o processo da LogMais Sul perde rendimento.",
